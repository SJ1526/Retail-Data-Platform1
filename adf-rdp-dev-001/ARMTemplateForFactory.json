{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-rdp-dev-001"
		},
		"pl_trigger_databricks_customer_job_properties_0_typeProperties_jobId": {
			"type": "string",
			"defaultValue": "609324242011405"
		},
		"ls_azuredatabricks_job_dev_properties_typeProperties_domain": {
			"type": "string",
			"defaultValue": "https://adb-7405615121107754.14.azuredatabricks.net"
		},
		"ls_azuredatabricks_job_dev_properties_typeProperties_workspaceResourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/4f0c7ea1-90d7-4477-bff0-a753c5ae53b6/resourceGroups/rgp-rdp-dev-001/providers/Microsoft.Databricks/workspaces/dbw-rdp-dev-001"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/pl_trigger_databricks_customer_job')]",
			"type": "Microsoft.DataFactory/factories/pipelines",
			"apiVersion": "2018-06-01",
			"properties": {
				"activities": [
					{
						"name": "run_databricks_customer_job",
						"type": "DatabricksJob",
						"dependsOn": [],
						"policy": {
							"timeout": "0.12:00:00",
							"retry": 0,
							"retryIntervalInSeconds": 30,
							"secureOutput": false,
							"secureInput": false
						},
						"userProperties": [],
						"typeProperties": {
							"jobId": "[parameters('pl_trigger_databricks_customer_job_properties_0_typeProperties_jobId')]"
						},
						"linkedServiceName": {
							"referenceName": "ls_azuredatabricks_job_dev",
							"type": "LinkedServiceReference"
						}
					}
				],
				"policy": {
					"elapsedTimeMetric": {}
				},
				"annotations": []
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/linkedServices/ls_azuredatabricks_job_dev')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/ls_azuredatabricks_job_dev')]",
			"type": "Microsoft.DataFactory/factories/linkedServices",
			"apiVersion": "2018-06-01",
			"properties": {
				"annotations": [],
				"type": "AzureDatabricks",
				"typeProperties": {
					"domain": "[parameters('ls_azuredatabricks_job_dev_properties_typeProperties_domain')]",
					"authentication": "MSI",
					"workspaceResourceId": "[parameters('ls_azuredatabricks_job_dev_properties_typeProperties_workspaceResourceId')]"
				}
			},
			"dependsOn": []
		}
	]
}