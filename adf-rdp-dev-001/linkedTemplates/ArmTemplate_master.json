{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "adf-rdp-dev-001"
		},
		"pl_trigger_databricks_customer_job_properties_0_typeProperties_jobId": {
			"type": "string",
			"defaultValue": "609324242011405"
		},
		"ls_azuredatabricks_job_dev_properties_typeProperties_domain": {
			"type": "string",
			"defaultValue": "https://adb-7405615121107754.14.azuredatabricks.net"
		},
		"ls_azuredatabricks_job_dev_properties_typeProperties_workspaceResourceId": {
			"type": "string",
			"defaultValue": "/subscriptions/4f0c7ea1-90d7-4477-bff0-a753c5ae53b6/resourceGroups/rgp-rdp-dev-001/providers/Microsoft.Databricks/workspaces/dbw-rdp-dev-001"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "adf-rdp-dev-001_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_azuredatabricks_job_dev_properties_typeProperties_domain": {
						"value": "[parameters('ls_azuredatabricks_job_dev_properties_typeProperties_domain')]"
					},
					"ls_azuredatabricks_job_dev_properties_typeProperties_workspaceResourceId": {
						"value": "[parameters('ls_azuredatabricks_job_dev_properties_typeProperties_workspaceResourceId')]"
					},
					"pl_trigger_databricks_customer_job_properties_0_typeProperties_jobId": {
						"value": "[parameters('pl_trigger_databricks_customer_job_properties_0_typeProperties_jobId')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}